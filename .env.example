# promobot - exemplo de configuracao. Copie para .env e preencha SO o que usar. NUNCA versione o .env.
# Vazio = recurso desligado ou usando o padrao do codigo (app/config.py).

# ===== PERFIL LEVE (padrao do kit; so troque quando souber o que faz) =====
# MODO SIMULACAO: o robo faz tudo, mas escreve em data/outbox.log em vez de enviar. Troque para false SO quando for ligar de verdade (docs/03, passo 11).
SIMULATE_POSTS=true
# Sem Docker: os servicos locais ficam em 127.0.0.1. Sem IA em tempo de execucao. Conteudo extra e redes sociais DESLIGADOS ate voce configurar.
# (Ja sao os padroes do codigo; as linhas abaixo existem para voce ver e poder mudar.)
#WA_URL=http://127.0.0.1:3000
#LINKGEN_URL=http://127.0.0.1:8000
#AI_ENABLED=false
#CONTENT_ENABLED=false
#SOCIAL_ENABLED=false
#THREADS_ENABLED=false
#ESTUDIO_ENABLED=false
# Mercado Livre por navegador (linkgen): ligue SO depois de fazer o login (docs/05). Sem ele o ML pede verificacao anti-robo e e pulado.
LINKGEN_ENABLED=false


# ===== Regras gerais, ritmo e horarios =====
# Banco: SQLite local; em produção troque por postgresql+psycopg://...
#DATABASE_URL=(calculado)
# tecnologia (foco do canal)
#MIN_DISCOUNT_PCT=30
# fora de tecnologia: só oferta absurda, e a IA ainda avalia
#ABSURD_DISCOUNT_PCT=60
# fora de tecnologia: só oferta absurda, e a IA ainda avalia
#DEDUPE_HOURS=24
#COLLECT_INTERVAL_MIN=15
# (legado)
#MAX_POSTS_PER_CYCLE=10
# (legado: substituído pelo intervalo variável abaixo)
#PUBLISH_INTERVAL_SEC=60
# Ritmo humano no WhatsApp: intervalo aleatório (minutos), menor nos horários de pico
#INTERVAL_MIN=10
#INTERVAL_MAX=18
#PEAK_INTERVAL_MIN=7
#PEAK_INTERVAL_MAX=12
# faixas [início, fim) em horário de Brasília
#PEAK_HOURS=11-14,19-23
# teto de posts de oferta por dia (cupons não contam)
#DAILY_POST_LIMIT=50
# ISO; zera a contagem do dia a partir deste momento (ex.: liberar mais posts em dia de teste)
#LIMIT_RESET_AT=
# dentro de REPEAT_DAYS só repete se o preço novo for >= 30% menor que o da última vez (dono, 23/10)
#REPEAT_MIN_DROP=0.3
# mesmo produto não volta antes disso
#REPEAT_DAYS=3
# oferta mais velha que isso na fila expira
#QUEUE_MAX_HOURS=6
# oferta mais velha que isso na fila expira
#LINKGEN_URL=http://127.0.0.1:8000
# navegador logado (ML: meli.la e cupons gerais). False no robô leve sem navegador
#LINKGEN_ENABLED=true
# corta peças avulsas/acessórios minúsculos (R$)
#SIMULATE_POSTS=false
# ex.: link de convite do grupo/canal do WhatsApp
#GROUP_INVITE_LINK=
# ex.: link de convite do grupo/canal do WhatsApp
#GROUP_INVITE_LABEL=Grupo no WhatsApp
# quando existir o canal do Telegram
#POST_HASHTAG=#Anuncio
#COUPON_REFRESH_HOURS=6
# agenda de conteúdo (stories, feed, educativo, jogos, reels). False no robô leve (só grupos)
#CONTENT_ENABLED=false
# valida se a foto é do produto (mesmo modelo: sem troca na GPU)
#VISION_MODEL=qwen3-vl:8b-instruct
# numero da loja so com digitos (5511999999999): vira o link wa.me/ dos orcamentos
#STORE_WHATSAPP=
# grupos, 1 mensagem a cada 1,5–4 min, quem já está nos grupos é pulado; texto em app/assets/convite.txt.
#CONVITE_ENABLED=false
#CONVITE_POR_DIA=50
#CONVITE_HORA=10:30
# publica das 6h...
#ACTIVE_HOUR_START=6
# ...até as 3h do dia seguinte (acima de 24 = vira a noite; 24 = até meia-noite)
#ACTIVE_HOUR_END=27
# madrugada: ritmo mais lento para não encher o grupo de notificações
#NIGHT_HOURS=0-3
# madrugada: ritmo mais lento para não encher o grupo de notificações
#NIGHT_INTERVAL_MIN=20
#NIGHT_INTERVAL_MAX=30
# 08/10/2026: SEM GPU (a RTX 4060 morreu): IA só na CPU (foto ~40 s, curadoria ~14 s). Com placa nova: 99 = todas as camadas na GPU
#BOT_AI_NUM_GPU=0
# dias de histórico antes de julgar
#PRICE_HISTORY_MIN_DAYS=3
# dias de histórico antes de julgar
#PRICE_HISTORY_WINDOW_DAYS=30
# abaixo do menor preço já visto em pelo menos X% = "menor preço em N dias"
#PRICE_DROP_PCT=5.0
# sugere no post um cupom ativo da loja (ML/Shopee) ou autorizado pela Awin (KaBuM)
#OFFER_COUPON_HINT=true
# aprovações informadas à mão (o token descobre sozinho)
#NO_OUTSIDE_COUPON_HOSTS=kabum.com.br,samsung.com
# cupons com código (Pelando): no máx. 1 post a cada N horas, só se houver código novo
#CODE_POST_GAP_HOURS=3
# post diário de cupons gerais
#COUPON_POST_HOUR=6
# Identidade do canal (artes das redes sociais)
#BRAND_NAME=Ofertas Tech
#BRAND_COLOR=#1E2A78
#ACCENT_COLOR=#FF3D57
# oferta no feed só nesses dias (feed = vitrine da loja)
#GAMES_DAY=thu
# carrossel educativo da loja (app/content.py)
#EDU_DAY=tue
# carrossel educativo da loja (app/content.py)
#EDU_TIME=19:00
# Epic libera grátis qui 12h
#GAMES_TIME=13:00
# 2ª edição: ofertas semanais da Steam começam na segunda
#GAMES2_DAY=mon
# 2ª edição: ofertas semanais da Steam começam na segunda
#GAMES2_TIME=19:00
#STATUS_ENABLED=false
# 14/10: oferta do dia, radar e top 5 fora do feed (dono: feed é conteúdo, venda vai p/ Stories)
#FEED_VENDAS_ENABLED=false
PEXELS_API_KEY=
# alterna: 1º horário = divulgação do grupo, 2º = oferta do dia
#STATUS_TIMES=12:30,20:00
# foco do dono (03/10): computador, peças, periféricos, games e celular
#PRIORITY_KEYWORDS=
# tecnologia primeiro (pedido do dono)  # coleta de cupons gerais do ML  # true = publica em data/outbox.log mesmo sem Telegram
#PRIORITY_BONUS=25
# tecnologia primeiro (pedido do dono)  # coleta de cupons gerais do ML  # true = publica em data/outbox.log mesmo sem Telegram
#BANNED_WORDS=recondicionado,usado,réplica
#REQUIRE_APPROVAL=false

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# false = não posta ofertas no canal do Telegram (pedido do dono 22/10)
#TELEGRAM_POST_ENABLED=true
TELEGRAM_ADMIN_CHAT_ID=
# quando existir o canal do Telegram
#TELEGRAM_INVITE_LINK=

# ===== Shopee (afiliado) =====
# palavras 'quentes' (app/trending.py) buscadas na Shopee a cada ciclo
#SHOPEE_TRENDING_PER_CYCLE=3
SHOPEE_APP_ID=
SHOPEE_SECRET=
#SHOPEE_KEYWORDS=
# palavras por coleta (rodízio); a API permite 2000 chamadas/hora
#SHOPEE_KEYWORDS_PER_CYCLE=3
# palavras por coleta (rodízio); a API permite 2000 chamadas/hora
#SHOPEE_LIMIT=30
#SHOPEE_MIN_PRICE=30.0
#SHOPEE_MIN_RATING=4.7
#SHOPEE_MIN_SOLD=20
# só loja oficial (Shopee Mall): loja indicada ainda vendia Logitech G304 falso a R$ 58
#SHOPEE_MALL_ONLY=true
# desconto acima disso em marca famosa costuma ser falsificado
#SHOPEE_MAX_DISCOUNT=70
# no máximo 1 Shopee a cada N posts (como o AliExpress)
#SHOPEE_EVERY=3
# cupons com código da Shopee (Pelando), igual ao do Mercado Livre
#SHOPEE_COUPONS_ENABLED=true
# cupom da Shopee esgota em ~1 h: avisa rápido
#SHOPEE_CODE_POST_GAP_HOURS=1

# ===== Pelando (fonte de apoio) =====
# Pelando no máx. 1 a cada N posts do canal (apoio; foco é Shopee/ML)
#PELANDO_EVERY=5
# ofertas votadas do Pelando (só AliExpress/ML)
#PELANDO_ENABLED=true
# temperatura (votos) mínima
#PELANDO_MIN_TEMP=100
# outras lojas (sem comissão, mantém o grupo movimentado): tecnologia votada
#PELANDO_BONUS_MIN_TEMP=100
# qualquer categoria se bombando (passa pela IA de curadoria)
#PELANDO_BONUS_ANY_TEMP=400
# 14/10: 48 h trazia preço que já tinha mudado na loja   # só ofertas postadas nas últimas N horas
#PELANDO_MAX_AGE_H=12
# 14/10: 48 h trazia preço que já tinha mudado na loja   # só ofertas postadas nas últimas N horas
#PELANDO_SEARCH_TERMS=
# termos buscados por coleta (rodízio): ~1 s cada
#PELANDO_SEARCH_PER_CYCLE=16
# na busca por palavra de tecnologia o voto mínimo é menor (a busca já filtra o assunto)
#PELANDO_SEARCH_MIN_TEMP=40

# ===== Mercado Livre (afiliado) =====
# com ML_PAUSED_UNTIL ativo: segue coletando ML e posta como BÔNUS (link limpo, sem comissão, sem abrir a página do produto)
#ML_BONUS_MODE=false
# AAAA-MM-DD: até esta data não coleta/posta ML (conta de afiliado suspensa)
#ML_PAUSED_UNTIL=
# etiqueta do afiliado ML por canal (Administrar etiquetas)
#ML_TAG_TECH=
# etiqueta do afiliado ML por canal (Administrar etiquetas)
#ML_TAG_LAR=

# ===== Canais do Telegram (fonte de emergencia) =====
# canais publicos do Telegram lidos so como FONTE DE EMERGENCIA (t.me/s/<canal>, sem login); vazio = desligado
#TG_CHANNELS=
# só lê os canais se a fila tiver MENOS que isso (0 = nunca)
#TG_EMERGENCY_QUEUE=8
# oferta de canal vence rápido
#TG_MAX_AGE_H=3
# encurtadores abertos por coleta (1 por segundo)
#TG_MAX_LINKS_PER_CYCLE=25
# peso no score (equivale a uma oferta morna do Pelando)
#TG_TEMP=120

# ===== AliExpress (afiliado) =====
# na busca por palavra de tecnologia o voto mínimo é menor (a busca já filtra o assunto)
#ALI_ENABLED=true
# no máximo 1 post do AliExpress a cada N (a nota dele é inflada pelo "preço antigo" e tomava a fila toda)
#ALI_EVERY=3
ALI_APP_KEY=
ALI_APP_SECRET=
# Portals > Account > Tracking ID
#ALI_TRACKING_ID=default
# informática, eletrônicos, celulares, componentes (vazio = todas)
#ALI_CATEGORY_IDS=7,44,509,502
# buscas por MARCA conhecida (13/10: a busca genérica trazia placa X99/memória/fonte sem procedência)
#ALI_KEYWORDS=
# busca do AliExpress só publica marca da lista app/titles.MARCAS
#ALI_KNOWN_BRANDS_ONLY=true
# palavras buscadas por coleta (rodízio): ~1 s cada pela API (~25 s no Portals)
#ALI_KEYWORDS_PER_CYCLE=5
# mínimo de vendas para confiar no produto
#ALI_MIN_SOLD=10
# corta peças avulsas/acessórios minúsculos (R$)
#ALI_MIN_PRICE=40.0

